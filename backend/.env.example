# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-flask-key-change-this
FLASK_DEBUG=True

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
JWT_EXPIRATION_HOURS=24

# ── Supabase PostgreSQL ───────────────────────────────────────────────────────
# How to get this:
#   1. Go to https://supabase.com/dashboard
#   2. Open your project → Settings → Database
#   3. Scroll to "Connection String" and select "URI" mode
#   4. Copy and paste the full URI below (replace [YOUR-PASSWORD])
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Supabase API Keys ────────────────────────────────────────────────────────
# How to get these:
#   1. Go to https://supabase.com/dashboard
#   2. Open your project → Settings → API
#   3. Copy the "anon public" key and "service_role" key
DATABASE_ANON=your-supabase-anon-key
DATABASE_SERVICE_ROLE=your-supabase-service-role-key
